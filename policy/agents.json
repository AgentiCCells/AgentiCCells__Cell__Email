{
  "schema": "cell.agents/1",
  "status": "proposal: altitude 3 of the email policy. Names agents only. Approvers (people who approve and start the gateway) are never named here: the gateway's operator pins them by key fingerprint outside the repository and the vault. Keys are bound in the registry, never here.",
  "agents": {
    "gateway.email@AgentiCCells.dinis": {
      "role": "gateway"
    },
    "firewall.email@AgentiCCells.dinis": {
      "role": "firewall"
    },
    "triage.email@AgentiCCells.dinis": {
      "role": "triage"
    },
    "drafter.email@AgentiCCells.dinis": {
      "role": "drafter"
    },
    "crm.email@AgentiCCells.dinis": {
      "role": "crm"
    },
    "person:assistant": {
      "role": "drafter"
    }
  },
  "roles": {
    "gateway": {
      "about": "Holds the Google token. Syncs in, sends approved actions, writes the outbox.",
      "lanes": {
        "outbox": [
          "sent",
          "refused",
          "failed"
        ],
        "reads": [
          "read"
        ],
        "approvals": [
          "gateway.stop"
        ]
      },
      "twin": [
        "raw",
        "clean"
      ]
    },
    "firewall": {
      "about": "Reads raw messages and writes the cleaned copy. Proposes nothing.",
      "lanes": {
        "reads": [
          "read"
        ],
        "approvals": [
          "gateway.stop"
        ]
      },
      "twin": [
        "raw",
        "clean"
      ]
    },
    "triage": {
      "about": "Reads cleaned copies, proposes labels and archiving.",
      "lanes": {
        "actions": [
          "propose.label",
          "propose.archive",
          "withdraw"
        ],
        "reads": [
          "read"
        ],
        "approvals": [
          "gateway.stop"
        ]
      },
      "twin": [
        "clean"
      ]
    },
    "drafter": {
      "about": "Reads cleaned copies, proposes replies and new emails.",
      "lanes": {
        "actions": [
          "propose.reply",
          "propose.send",
          "withdraw"
        ],
        "reads": [
          "read"
        ],
        "approvals": [
          "gateway.stop"
        ]
      },
      "twin": [
        "clean"
      ]
    },
    "crm": {
      "about": "Reads cleaned copies and links them to people in the CRM. Proposes labels only.",
      "lanes": {
        "actions": [
          "propose.label"
        ],
        "reads": [
          "read"
        ],
        "approvals": [
          "gateway.stop"
        ]
      },
      "twin": [
        "clean"
      ]
    }
  }
}
